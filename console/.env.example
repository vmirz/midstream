# The domains this console serves (handbook 20): a JSON registry, from a file (the chart mounts one) or
# inline. Unset, one domain, `local`, at http://localhost:6065 — a port-forwarded control plane.
# Each domain's service token, the same value as its control plane's AUTH_SERVICE_TOKEN, comes from
# CONSOLE_DOMAIN_<ID>_SERVICE_TOKEN; without it that domain's live views read as a guest.
# CONSOLE_DOMAINS_FILE=/etc/midstream/domains.json
# CONSOLE_DOMAINS=[{"id":"local","name":"Local","local":true,"settingsHome":true,"controlPlaneUrl":"http://localhost:6065","tailUrl":null}]
# CONSOLE_DOMAIN_LOCAL_SERVICE_TOKEN=
CONTROL_PLANE_TIMEOUT_MS=10000
# The URL people use; where providers send people back to. Unset: the URL each request arrived at.
# CONSOLE_URL=http://localhost:5173

# Sign-in. People's accounts live in each domain's control plane; the console keeps one session per
# domain in a cookie, <CONSOLE_SESSION_COOKIE>_<domain id>.
# CONSOLE_SESSION_COOKIE=midstream_session
# auto: Secure when the request arrived over HTTPS, as the ingress reports it.
# CONSOLE_COOKIE_SECURE=auto
# CONSOLE_SESSION_CHECK_MS=5000
# CONSOLE_SIGN_IN_ATTEMPTS_PER_MINUTE=10
# Single sign-on: each provider the console is registered with (client id and secret; Entra's tenant,
# the OpenID Connect issuer). Every domain checks the result itself (handbook 18 §18.17).
# CONSOLE_SSO_OIDC_ISSUER=https://dex.example.com
# CONSOLE_SSO_OIDC_CLIENT_ID=
# CONSOLE_SSO_OIDC_CLIENT_SECRET=
# CONSOLE_SSO_OIDC_LABEL=Dex

# Console server
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info
CONSOLE_SERVE_CLIENT=true
# CONSOLE_CORS_ORIGIN=http://localhost:5173

# Live refresh cadence
CONSOLE_LIST_POLL_MS=2000
CONSOLE_DETAIL_POLL_MS=1500
CONSOLE_FLEET_DETAIL_POLL_MS=6000
CONSOLE_IDLE_POLL_MS=30000
CONSOLE_SERIES_POINTS=240
CONSOLE_SERIES_SAMPLE_MS=5000
# Rates are measured per runtime member between its own heartbeats, over these spans.
CONSOLE_INGEST_RATE_WINDOW_MS=60000
CONSOLE_WRITE_RATE_WINDOW_MS=900000
CONSOLE_LAG_HISTORY_MS=21600000

# Data access
CONSOLE_DATA_ACCESS_ENABLED=true
# Remote Parquet reads block a thread per request, so threads are also requests in flight.
CONSOLE_DUCKDB_MEMORY_LIMIT=4GB
CONSOLE_DUCKDB_THREADS=32
# Runs: the console's single unit of query work. Node's worker pool (UV_THREADPOOL_SIZE) is sized
# from these at startup, since every DuckDB query in flight holds one of its threads.
# CONSOLE_RUN_CONCURRENCY=4
# CONSOLE_RUN_SCAN_CONCURRENCY=48
# CONSOLE_RESULT_ROW_LIMIT=1000000
# CONSOLE_EXPORT_ROW_LIMIT=1000000

# Live tail: each domain's tail app is its registry entry's tailUrl (above), for each table's newest
# records before they are committed (docs/07 §07.9). Without one, that domain's tables show committed
# rows only. These can also be changed on the Settings page (Live tail).
# CONSOLE_LIVE_TAIL_ENABLED=true
# CONSOLE_LIVE_TAIL_REFRESH_MS=1500
# CONSOLE_LIVE_TAIL_MAX_ROWS=100000
# CONSOLE_LIVE_TAIL_TIMEOUT_MS=3000

# Storage profiles (docs/07 §07.10): one per destination prefix, which the console reads each table's
# objects with, by the longest scope covering its location. Without any, the console reads no object
# storage. The chart renders CONSOLE_STORAGE_FILE; for development the same JSON may be inline:
# CONSOLE_STORAGE='[{"name":"lake","scope":"s3://example-lake/","kind":"s3","endpoint":"http://localhost:8333","pathStyle":true},{"name":"archive","scope":"gs://example-archive/","kind":"gcs"},{"name":"azure-lake","scope":"abfss://lake@exampleacct.dfs.core.windows.net/","kind":"azure"}]'
# Each profile's credentials come from CONSOLE_STORAGE_<NAME>_… (NAME in upper case, '-' as '_'),
# never from the JSON. Give them read-only access. Without an HMAC pair a gcs profile is cached.
# CONSOLE_STORAGE_LAKE_ACCESS_KEY_ID=
# CONSOLE_STORAGE_LAKE_SECRET_ACCESS_KEY=
# CONSOLE_STORAGE_LAKE_SESSION_TOKEN=
# CONSOLE_STORAGE_ARCHIVE_GCS_HMAC_KEY_ID=
# CONSOLE_STORAGE_ARCHIVE_GCS_HMAC_SECRET=
# CONSOLE_STORAGE_AZURE_LAKE_AZURE_CONNECTION_STRING=
# CONSOLE_STORAGE_AZURE_LAKE_AZURE_ACCOUNT_KEY=
# CONSOLE_STORAGE_AZURE_LAKE_AZURE_CLIENT_ID= / _AZURE_TENANT_ID= / _AZURE_CLIENT_SECRET=

# Local cache and schema history location
# CONSOLE_DATA_DIR=/var/lib/midstream-console
# CONSOLE_PARQUET_CACHE_MAX_BYTES=8589934592
# CONSOLE_CACHED_MODE_MAX_BYTES=2147483648
# CONSOLE_CACHED_MODE_MAX_FILES=400
