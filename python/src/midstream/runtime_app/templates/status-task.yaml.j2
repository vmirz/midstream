apiVersion: kaspr.io/v1alpha1
kind: KasprTask
metadata:
  name: {{ status_task_name }}
  namespace: {{ namespace }}
  labels:
    kaspr.io/app: {{ runtime_app_name }}
{{ labels | to_yaml(4) }}
spec:
  name: {{ status_task_name }}
  description: Emit per-instance runtime heartbeat snapshots.
  schedule:
    interval: {{ heartbeat_interval }}
  processors:
    pipeline:
      - build-status-snapshot
      - send-status-snapshot
    init:
      python: |
        from midstream.runtime_app.handlers.status import build_runtime_heartbeat

        # The runtime's tables, by name, in the materialization's order.
        TABLE_NAMES = {{ tables | map(attribute="name") | list | tojson }}
    operations:
      - name: build-status-snapshot
        tables:
          - name: {{ state_table_name }}
            paramName: state_table
        map:
          entrypoint: emit_snapshot
          python: |
            def emit_snapshot(state_table):
                return build_runtime_heartbeat(
                    state_table,
                    materialization_id={{ materialization_id | tojson }},
                    runtime_app_ref={{ runtime_app_name | tojson }},
                    agent_name={{ writer_agent_name | tojson }},
                    tables=TABLE_NAMES,
                )
      - name: send-status-snapshot
        topicSend:
          name: {{ materialization_status_topic }}
          valueSerializer: json
          keySelector:
            python: |
              def select_key(value):
                  # Must be the same partition key every other producer uses. Keying status by the
                  # bare id sent these events to a different partition from the work and request
                  # streams, so the control plane's state for one materialization could be written
                  # into two shards — which is how a stale copy outlived a delete.
                  from midstream.storage import materialization_routing_key

                  return materialization_routing_key(value["materialization_id"])
          valueSelector:
            python: |
              def select_value(value):
                  return value
