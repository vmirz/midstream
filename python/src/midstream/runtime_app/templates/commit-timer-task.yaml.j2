apiVersion: kaspr.io/v1alpha1
kind: KasprTask
metadata:
  name: {{ commit_timer_task_name }}
  namespace: {{ namespace }}
  labels:
    kaspr.io/app: {{ runtime_app_name }}
{{ labels | to_yaml(4) }}
spec:
  name: {{ commit_timer_task_name }}
  description: Tick the committer's commit clock; one member sends it.
  onLeader: true
  schedule:
    interval: {{ commit_timer_interval }}
  processors:
    pipeline:
      - build-tick
      - send-tick
    init:
      python: |
        from midstream.runtime_app.committer import build_commit_tick
    operations:
      - name: build-tick
        map:
          entrypoint: build
          python: |
            def build():
                return build_commit_tick(materialization_id={{ materialization_id | tojson }})
      - name: send-tick
        topicSend:
          name: {{ commits_topic_name }}
          valueSerializer: json
          keySelector:
            python: |
              def select_key(value):
                  return "commits"
          valueSelector:
            python: |
              def select_value(value):
                  return value
