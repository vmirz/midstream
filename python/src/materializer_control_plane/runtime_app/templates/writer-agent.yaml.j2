apiVersion: kaspr.io/v1alpha1
kind: KasprAgent
metadata:
  name: {{ writer_agent_name }}
  namespace: {{ namespace }}
  labels:
    kaspr.io/app: {{ runtime_app_name }}
{{ labels | to_yaml(4) }}
spec:
  description: Stage assigned source records for their topic's table, and ask the committer for any schema they need.
  # One actor per assigned partition of any of the source topics: Faust isolates each topic and
  # partition, so every table's partitions are staged, sealed and acknowledged on their own.
  isolatedPartitions: true
  # Records are acknowledged by the runtime's ack ledger once the table holds their rows, so an
  # offset never commits ahead of its data (runtime_app/acks.py). No outputs: schema change requests
  # and file announcements go to the committer through the pipeline task's outbox.
  noack: true
  input:
    topic:
      # Every source topic of the materialization; each record goes to its topic's table.
      name: {{ source_topics | join(",") }}
      valueSerializer: json
  processors:
    pipeline:
      - stage-source-record
    init:
      python: |
        from materializer_control_plane.runtime_app.handlers.writer import stage_source_record
        from materializer_control_plane.runtime_app.table_state import table_contexts

        # Built once: every record finds its table by its topic in these.
        TABLES = table_contexts(
            {{ materialization_id | tojson }},
            {{ tables | tojson }},
            partition_granularity={{ partition_granularity | tojson }},
        )
    operations:
      - name: stage-source-record
        tables:
          - name: {{ state_table_name }}
            paramName: state_table
        map:
          entrypoint: process_record
          python: |
            async def process_record(value, state_table):
                await stage_source_record(
                    value,
                    state_table,
                    context=context,
                    materialization_id={{ materialization_id | tojson }},
                    runtime_app_ref={{ runtime_app_name | tojson }},
                    tables=TABLES,
                    {# Rendered only when enabled, so a runtime without it keeps its spec hash. #}
                    {% if skip_tombstones %}
                    skip_tombstones=True,
                    {% endif %}
                )
                return None
