{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/control-plane/contracts/runtime-status-event.schema.json",
  "title": "Runtime Status Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "materialization_id",
    "runtime_app_ref",
    "member_id",
    "agent_name",
    "phase",
    "health",
    "schema_version",
    "reported_at"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "materialization_id": {
      "type": "string",
      "minLength": 1
    },
    "runtime_app_ref": {
      "type": "string",
      "minLength": 1
    },
    "member_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_name": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": "string",
      "enum": ["running", "degraded"]
    },
    "health": {
      "type": "string",
      "enum": ["healthy", "degraded", "unknown"]
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "rows_written": {
      "type": "integer",
      "minimum": 0
    },
    "bytes_written": {
      "type": "integer",
      "minimum": 0
    },
    "files_written": {
      "type": "integer",
      "minimum": 0
    },
    "latest_offsets": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[0-9]+$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "event_time": {
      "type": "string",
      "format": "date-time"
    },
    "reported_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_error": {
      "type": ["string", "null"]
    }
  }
}