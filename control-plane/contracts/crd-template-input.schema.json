{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/control-plane/contracts/crd-template-input.schema.json",
  "title": "Dedicated Runtime CRD Template Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "materialization_id",
    "runtime_mode",
    "runtime_app_name",
    "namespace",
    "source_topic",
    "destination_uri",
    "schema_version",
    "managed_agent_names",
    "template_version"
  ],
  "properties": {
    "materialization_id": {
      "type": "string",
      "minLength": 1
    },
    "runtime_mode": {
      "type": "string",
      "const": "dedicated"
    },
    "runtime_app_name": {
      "type": "string",
      "minLength": 1
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "source_topic": {
      "type": "string",
      "minLength": 1
    },
    "destination_uri": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "managed_agent_names": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "resource_profile": {
      "type": ["string", "null"]
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "annotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "python_packages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packages"],
      "properties": {
        "packages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "template_version": {
      "type": "string",
      "minLength": 1
    }
  }
}